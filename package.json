{
  "name": "@yirc99/dsh-jev-context",
  "version": "0.1.0",
  "description": "JEV-scored context selection: keep only the earlier conversation a turn needs, and record what each turn loaded.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "harness",
    "context",
    "compaction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yirc99/dsh-jev-context.git"
  },
  "homepage": "https://github.com/yirc99/dsh-jev-context#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:local": "tsc -p tsconfig.local.json",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-compaction": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-store": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-compaction": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.7-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.15.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
